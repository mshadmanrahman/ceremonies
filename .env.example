# Clerk (from Vercel Marketplace integration)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Postgres (from Vercel Marketplace integration)
DATABASE_URL=

# PartyServer worker host (for production), e.g. ceremonies-live.<subdomain>.workers.dev
NEXT_PUBLIC_PARTYKIT_HOST=

# Sentry error monitoring. DSN is required for events; org/project/token only for source map upload.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
